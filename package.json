{
  "name": "aphra-web",
  "description": "Aphra website",
  "version": "1.0.0",
  "private": true,
  "author": "Jerome Portier",
  "license": "UNLICENSED",
  "keywords": [],
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "vitest --run",
    "check": "npm run format && npm run lint && npm run typecheck && npm run secretlint && npm run test",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "secretlint": "secretlint \"**/*\"",
    "prepare": "husky",
    "test:unit": "vitest unit --run",
    "test:integration": "vitest int --run",
    "test:coverage": "vitest --coverage --run",
    "test:e2e": "npx playwright test",
    "test:e2e:ui": "npx playwright test --ui",
    "build": "tsc -b && vite build",
    "dev": "vite",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.5",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "happy-dom": "^20.14.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.9",
    "secretlint": "^13.0.5",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.103.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-error-boundary": "^6.1.6",
    "react-router": "^8.4.0",
    "tailwindcss": "^4.3.3"
  },
  "directories": {
    "doc": "docs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aphra-lab/aphra-web.git"
  },
  "bugs": {
    "url": "https://github.com/Aphra-lab/aphra-web/issues"
  },
  "homepage": "https://github.com/Aphra-lab/aphra-web#readme",
  "lint-staged": {
    "**/*": [
      "npm run format",
      "npm run lint",
      "npm run secretlint"
    ]
  }
}
