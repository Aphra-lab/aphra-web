{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "aphra-design",
  "compatibility_date": "2026-09-23",
  "assets": { "directory": "./storybook-static" },
  "workers_dev": false,
  "routes": [{ "pattern": "design.aphralab.com", "custom_domain": true }],
  "env": {
    "staging": { "workers_dev": true, "routes": [] },
  },
}
